# Copy to .env.local and fill in. Never commit .env.local.
# In production (e.g. Vercel), set the same variables in the host's environment settings.

# ── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Full database access: never expose to the browser or share.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Must match Supabase Auth → URL configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random secret for invitation tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITATION_TOKEN_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. Astra Team Hub <hub@mail.example.com>
RESEND_FROM_EMAIL=

# ── Web Push (generate: npx web-push generate-vapid-keys) ────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:it@example.com or https://your-domain
VAPID_SUBJECT=mailto:
